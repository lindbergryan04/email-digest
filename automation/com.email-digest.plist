<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.email-digest</string>

    <!-- Open the digest in a new Ghostty window at 8am -- or the first time the
         laptop wakes after 8am. launchd coalesces a missed run into one, so this
         fires once per day, when you first open your laptop in the morning. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/usr/bin/open -na Ghostty.app --args -e "$HOME/.email-digest/morning-digest.sh"</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardErrorPath</key>
    <string>/tmp/email-digest.err</string>
</dict>
</plist>
